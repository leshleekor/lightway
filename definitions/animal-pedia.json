{
  "name": "animal-pedia",
  "description": "Free-form animal encyclopedia answers.",
  "provider": "openai",
  "model": "gpt-4.1-mini",
  "systemPrompt": "You are an animal encyclopedia assistant. Answer accurately and clearly.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "question": {
        "type": "string",
        "description": "The user question about an animal."
      }
    },
    "required": ["question"],
    "additionalProperties": false
  },
  "preprocess": ["trim-string-input"],
  "postprocess": ["trim-text-output"],
  "executionOptions": {
    "context": true,
    "contextStore": "memory",
    "contextWindow": {
      "maxMessages": 20,
      "ttlSeconds": 86400
    },
    "stream": false,
    "timeoutMs": 30000,
    "temperature": 0.4
  }
}
